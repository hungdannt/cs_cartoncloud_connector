<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_discrepancy_adjustment_view_form" model="ir.ui.view">
        <field name="name">stock.discrepancy.adjustment.wizard.form</field>
        <field name="model">stock.discrepancy.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="file_import" filename="name"/>
                    <field name="name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_get_template" string="Get Template" type="object" class="btn btn-secondary"/>
                    <button name="action_import" string="Import" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_discrepancy_adjustment_act" model="ir.actions.act_window">
        <field name="name">Stock Discrepancy Adjustment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.discrepancy.adjustment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="Stock Discrepancy Adjustment" id="stock_discrepancy_adjustment_menu" parent="stock.menu_stock_adjustments" sequence="60" action="stock_discrepancy_adjustment_act"/>
</odoo>