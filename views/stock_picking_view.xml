<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_form_inherit_view" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_cartoncloud_send_internal_transfer"
                    type="object"
                    class="oe_highlight"
                    icon="fa-truck"
                    invisible="picking_type_code != 'internal' or cartoncloud_inbound_order_uuid"
                    string="CartonCloud"
                />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="cartoncloud_consignment_uuid" invisible="picking_type_code == 'incoming' or picking_type_code == 'internal'" />
                <field name="cartoncloud_consignment_status" invisible="picking_type_code == 'incoming' or picking_type_code == 'internal'" readonly="1" />
                <field name="cartoncloud_inbound_order_uuid" invisible="picking_type_code != 'internal'" />
                <field name="cartoncloud_inbound_order_status" invisible="picking_type_code != 'internal'" readonly="1" />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="cartoncloud_last_poll_message" string="CartonCloud Message" invisible="not cartoncloud_inbound_order_uuid" />
            </xpath>
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="cartoncloud_internal_so_id" invisible="not cartoncloud_internal_so_id" />
                <field name="cartoncloud_internal_po_id" invisible="not cartoncloud_internal_po_id" />
            </xpath>
        </field>
    </record>

</odoo>
