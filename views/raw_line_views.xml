<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="cs_cartoncloud_raw_line_form_view" model="ir.ui.view">
        <field name="name">cs.cartoncloud.raw.line.form.view</field>
        <field name="model">cs.cartoncloud.raw.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="raw_id" readonly="1" />
                            <field name="picking_id" readonly="1" />
                        </group>
                        <group>
                            <field name="uuid" readonly="1" />
                            <field name="request_type" readonly="1" />
                            <field name="remark" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data">
                            <group>
                                <field name="raw_data_text_id" invisible="1" />
                                <field name="raw_data" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cs_cartoncloud_raw_line_tree_view" model="ir.ui.view">
        <field name="name">cs.cartoncloud.raw.line.tree.view</field>
        <field name="model">cs.cartoncloud.raw.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="uuid" />
                <field name="request_type" />
                <field name="picking_id" />
                <field name="state" />
                <field name="remark" />
            </tree>
        </field>
    </record>

</odoo>
